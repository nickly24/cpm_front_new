# Production: set these public values in Timeweb BEFORE building the frontend.
NEXT_PUBLIC_CPM_BFF_ENABLED=1
NEXT_PUBLIC_CPM_BFF_BASE_URL=https://back1.cpm-lms.ru:8443/bff/
NEXT_PUBLIC_CPM_BFF_EXTERNAL_TESTS_ENABLED=1
NEXT_PUBLIC_CPM_S3_ORIGINS=https://s3.twcstorage.ru

# Local Go BFF: use NEXT_PUBLIC_CPM_BFF_DEV=1 and NEXT_PUBLIC_CPM_BFF_BASE_URL=/bff.
# The development rewrite forwards /bff to http://127.0.0.1:8001.
